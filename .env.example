# Optional provider credentials. Blank values mean the key is unset.
# The API starts without these. Copy this file to .env and replace the
# placeholders locally. Do not commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama URL. Startup does not connect to it.
OLLAMA_BASE_URL=http://localhost:11434

LOW_COMPLEXITY_THRESHOLD=0.30
HIGH_COMPLEXITY_THRESHOLD=0.70
MIN_QUALITY_SCORE=0.75
MAX_MODEL_ATTEMPTS=3
