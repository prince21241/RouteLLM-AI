# Optional provider credentials. Blank values mean the key is unset.
# The API starts without these. Copy this file to .env and replace the
# placeholders locally. Do not commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI Responses API. gpt-5-nano uses minimal reasoning effort in code.
# max output tokens include visible text and reasoning tokens.
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_OUTPUT_TOKENS=256
OPENAI_TIMEOUT_SECONDS=30
# Routing participation is explicit. A provider adapter is not enough.
# gpt-5-nano is also omitted until OPENAI_API_KEY is set.
OPENAI_ROUTING_ENABLED=true
# Routing policy label, not a benchmark score.
OPENAI_QUALITY_TIER=low

# Anthropic Messages API. The client sends non-streaming requests.
# Leave routing off until you intend to send live Anthropic traffic.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_ROUTING_ENABLED=false
ANTHROPIC_QUALITY_TIER=high

# Local Ollama chat API. Startup does not connect to it.
# Leave routing off until a model is installed and you want it selected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_ROUTING_ENABLED=false
OLLAMA_QUALITY_TIER=low

# Empty means registration order: OpenAI model, Anthropic model, Ollama model.
# Example: gpt-5-nano,claude-sonnet-4-6,llama3.2
ROUTING_PREFERENCE=

# Application character limit for the user prompt plus system prompt.
# This is not a model context-window or token check.
MAX_INPUT_CHARACTERS=8000

LOW_COMPLEXITY_THRESHOLD=0.30
HIGH_COMPLEXITY_THRESHOLD=0.70
MIN_QUALITY_SCORE=0.75
MAX_MODEL_ATTEMPTS=3

# Local PostgreSQL. Leave this blank to run without persistence.
# The password below matches the Docker Compose development default.
# Override POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB before
# `docker compose up` if you do not want those defaults.
DATABASE_URL=postgresql+asyncpg://routellm:routellm@127.0.0.1:5432/routellm

# Premium baseline used only for a same-token-volume cost estimate.
# It does not need to be enabled for routing, and it is never called.
# Set this to empty to omit the estimate.
PREMIUM_BASELINE_MODEL=claude-sonnet-4-6
